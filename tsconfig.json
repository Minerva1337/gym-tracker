{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,             // Erzeugt .d.ts-Dateien
    "sourceMap": true,               // Erzeugt source maps für Debugging
    "outDir": "./dist",              // Alle Dateien werden im dist-Ordner erzeugt
    "esModuleInterop": true,         // Ermöglicht es, mit ES- und CommonJS-Modulen zu arbeiten
    "skipLibCheck": true,            // Bibliothekstypen nicht prüfen (für Performance)
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],               // Setzt Typen von node
    "strict": true                   // Strikte Typprüfung aktivieren
  },
  "include": ["src/**/*.ts"],          // Alle TS-Dateien aus dem src-Ordner
  "exclude": ["node_modules"]          // Den node_modules-Ordner ausschließen
}