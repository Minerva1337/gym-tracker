{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "strict": true,
    "experimentalDecorators": true,  // <- Füge das hier hinzu
    "emitDecoratorMetadata": true     // <- Und das hier
  },
  "include": ["backend/**/*.ts"],  // Oder was immer du hier verwendest
  "exclude": ["node_modules"]
}